# 遇见路得后端环境变量示例 — 复制为 .env 并填入真实值
# 切勿把真实 .env 提交到 git

# PostgreSQL 连接串
DATABASE_URL=postgres://edu_admin:password@localhost:5432/yujian_lude

# 服务端口
PORT=8090

# session cookie 签名密钥（生产环境必须改成 32 字符以上长随机串）
SESSION_SECRET=change-this-to-a-long-random-string

# session 有效期（天）
SESSION_TTL_DAYS=30

# 运行环境 development / production（生产必须为 production）
NODE_ENV=development

# 是否在跨域 https 下启用 secure cookie（生产必须 true）
COOKIE_SECURE=false

# 是否在本地开发时把邮箱验证/找回密码 token 直接返回给前端（生产必须 false）
EXPOSE_DEV_TOKENS=false

# 用户收到的验证与重置链接使用的公开站点地址（生产必须是 HTTPS）
PUBLIC_APP_URL=http://localhost:5173

# SMTP 邮件服务。生产环境必须配置 SMTP_HOST 与 SMTP_FROM。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=遇见路得 <no-reply@example.com>

# 上线前本地体检临时服务起始端口；可选，默认 8092
RELEASE_VERIFY_PORT=8092
