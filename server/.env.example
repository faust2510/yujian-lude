# 遇见路得后端环境变量示例 — 复制为 .env 并填入真实值
# 切勿把真实 .env 提交到 git

# PostgreSQL 连接串
DATABASE_URL=postgres://edu_admin:password@localhost:5432/yujian_lude

# 服务端口
PORT=8090

# session cookie 签名密钥（生产环境必须改成 32 字符以上长随机串）
SESSION_SECRET=change-this-to-a-long-random-string

# session 有效期（天）
SESSION_TTL_DAYS=30

# 运行环境 development / production（生产必须为 production）
NODE_ENV=development

# 是否在跨域 https 下启用 secure cookie（生产必须 true）
COOKIE_SECURE=false

# 是否在本地开发时把邮箱验证/找回密码 token 直接返回给前端（生产必须 false）
EXPOSE_DEV_TOKENS=false

# OpenAI 兼容 AI 教导助手；生产环境通过部署环境注入真实密钥
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=10

# 头像与教材私有文件目录（不要放在静态网站根目录）
MEDIA_DIR=/opt/yujian-lude/storage

# 上线前本地体检临时服务起始端口；可选，默认 8092
RELEASE_VERIFY_PORT=8092
